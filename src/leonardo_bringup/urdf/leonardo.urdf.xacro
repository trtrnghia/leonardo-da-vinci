<?xml version="1.0"?>
<!-- URDF Skeleton for Leonardo da Vinci 3-Wheel Omni Robot -->
<robot name="leonardo" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="base_footprint"/>
  
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>
</robot>
