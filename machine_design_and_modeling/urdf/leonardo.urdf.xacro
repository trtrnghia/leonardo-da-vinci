<?xml version="1.0"?>
<robot name="leonardo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Materials -->
  <material name="chassis_mat">
    <color rgba="0.15 0.15 0.20 0.95"/>
  </material>
  <material name="wheel_mat">
    <color rgba="0.80 0.40 0.10 1.0"/>
  </material>
  <material name="pen_mat">
    <color rgba="0.90 0.10 0.10 1.0"/>
  </material>
  <material name="sensor_mat">
    <color rgba="0.10 0.60 0.80 1.0"/>
  </material>

  <!-- Base Footprint (Ground Projection) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Base Link (Chassis Body) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.06"/>
      </geometry>
      <material name="chassis_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <inertia ixx="0.0148" ixy="0" ixz="0" iyy="0.0148" iyz="0" izz="0.0281"/>
    </inertial>
  </link>

  <!-- Omni Wheels (3x at 120-deg separation, R=0.15m, r=0.029m) -->
  <!-- Wheel 1: Alpha = 0 deg (aligned along Y) -->
  <link name="wheel_1_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.029" length="0.025"/>
      </geometry>
      <material name="wheel_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.029" length="0.025"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_1_link"/>
    <origin xyz="0.0 0.15 -0.021" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Wheel 2: Alpha = 120 deg (xyz: -0.1299, -0.075, -0.021) -->
  <link name="wheel_2_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.029" length="0.025"/>
      </geometry>
      <material name="wheel_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.029" length="0.025"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_2_link"/>
    <origin xyz="-0.1299 -0.075 -0.021" rpy="0 0 2.0944"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Wheel 3: Alpha = 240 deg (xyz: 0.1299, -0.075, -0.021) -->
  <link name="wheel_3_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.029" length="0.025"/>
      </geometry>
      <material name="wheel_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.029" length="0.025"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_3_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_3_link"/>
    <origin xyz="0.1299 -0.075 -0.021" rpy="0 0 -2.0944"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Pen Actuator (Centered) -->
  <link name="pen_holder_link">
    <visual>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.06"/>
      </geometry>
      <material name="pen_mat"/>
    </visual>
  </link>
  <joint name="pen_holder_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="pen_holder_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.015" upper="0.015" effort="10.0" velocity="0.1"/>
  </joint>

  <link name="pen_tip"/>
  <joint name="pen_tip_joint" type="fixed">
    <parent link="pen_holder_link"/>
    <child link="pen_tip"/>
    <origin xyz="0 0 -0.04" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR Sensor -->
  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.03"/>
      </geometry>
      <material name="sensor_mat"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- Camera (Down-facing) -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.025 0.02"/>
      </geometry>
      <material name="sensor_mat"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.08 0 -0.02" rpy="0 1.5708 0"/>
  </joint>

  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

</robot>
